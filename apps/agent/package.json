{
  "name": "@repo/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsc --sourceMap && concurrently -k -n tsc,node -c blue,green \"tsc -w --preserveWatchOutput --sourceMap\" \"node --enable-source-maps --watch --watch-preserve-output dist/main.js\"",
    "build": "tsc && mkdir -p dist/sandbox && cp src/sandbox/run-validation.sh dist/sandbox/run-validation.sh",
    "start": "node dist/main.js",
    "check-types": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@repo/types": "workspace:*",
    "dotenv": "^16.4.5",
    "fastify": "^5.3.0",
    "pino": "^9.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
