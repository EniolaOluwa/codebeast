PORT=3002
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Shared with apps/api (Bearer token on every agent route).
AGENT_SERVICE_TOKEN=dev-agent-token-change-me

# OpenAI-compatible chat API (provider-agnostic).
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL_PLANNER=deepseek-reasoner
LLM_MODEL_CODER=deepseek-chat
LLM_MAX_TURNS=24

# Git workspace cache (must be bind-mountable into sandbox containers).
WORKSPACE_ROOT=/tmp/codebeast-workspaces
WORKSPACE_TTL_MS=3600000

# Docker sandbox.
SANDBOX_IMAGE=node:22-bookworm
SANDBOX_TIMEOUT_MS=600000
