{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsc --sourceMap && concurrently -k -n tsc,node -c blue,green \"tsc -w --preserveWatchOutput --sourceMap\" \"node --enable-source-maps --watch --watch-preserve-output dist/main.js\"",
    "build": "tsc",
    "start": "node dist/main.js",
    "check-types": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^10.1.6",
    "@fastify/under-pressure": "^9.2.1",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@repo/db": "workspace:*",
    "@repo/types": "workspace:*",
    "bullmq": "^6.4.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.3.0",
    "ioredis": "^6.0.0",
    "nestjs-zod": "^5.5.0",
    "prisma": "^6.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@swc/core": "^1.16.18",
    "@testcontainers/postgresql": "^12.2.1",
    "@vitest/coverage-v8": "^3.2.0",
    "concurrently": "^9.2.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.0"
  }
}
