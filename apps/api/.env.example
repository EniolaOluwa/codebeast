DATABASE_URL=postgresql://postgres:postgres@localhost:5434/codebeast?schema=public
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Auth (use strong, unique values outside local dev)
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
ENCRYPTION_KEY=change-me-to-a-long-random-value-at-least-32-chars

# Pipeline queue
REDIS_URL=redis://localhost:6379
QUEUE_ENABLED=true

# Agent service
AGENT_SERVICE_URL=http://localhost:4000

# Webhooks
WEBHOOK_BASE_URL=http://localhost:3001

# GitHub App (required for PR creation)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
