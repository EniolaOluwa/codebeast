DATABASE_URL=postgresql://postgres:postgres@localhost:5434/codebeast?schema=public
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Generate with 'openssl rand -base64 32'. Required in production.
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Generate with 'openssl rand -hex 32'. Required in production.
JWT_SECRET=dev-only-jwt-secret-do-not-use-in-production
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=1209600

# How long raw webhook payloads are kept before the janitor nulls them (0 = drop immediately).
WEBHOOK_RAW_TTL_DAYS=7

# BullMQ queues (Phase 4).
REDIS_URL=redis://localhost:6379
