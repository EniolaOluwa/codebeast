DATABASE_URL=postgresql://postgres:postgres@localhost:5434/codebeast?schema=public
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000

# Generate with 'openssl rand -base64 32'. Required in production.
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Generate with 'openssl rand -hex 32'. Required in production.
JWT_SECRET=dev-only-jwt-secret-do-not-use-in-production
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=1209600

# How long raw webhook payloads are kept before the janitor nulls them (0 = drop immediately).
WEBHOOK_RAW_TTL_DAYS=7

# BullMQ queues (Phase 4).
REDIS_URL=redis://localhost:6379
# Signals for one issue coalesce into a single triage within this window.
INGEST_COALESCE_MS=30000

# GitHub App (Phase 5). Unset = stub client (pretends to open PRs).
# GITHUB_APP_ID=123456
# GITHUB_APP_PRIVATE_KEY_BASE64=$(base64 -i app.pem)

# Source clients. stub (default) never hits the network; api uses the tenant
# integration's config (siteUrl/domain/channels) + secrets (email/apiToken,
# botToken, apiKey).
JIRA_CLIENT_MODE=stub
DISCORD_CLIENT_MODE=stub
FRESHDESK_CLIENT_MODE=stub

# Agent reasoning service. stub (default) never hits the network; http calls
# apps/agent (see apps/agent/.env.example). Token must match AGENT_SERVICE_TOKEN.
AGENT_CLIENT_MODE=stub
AGENT_SERVICE_URL=http://localhost:3002
AGENT_SERVICE_TOKEN=dev-agent-token-change-me
